{
  "name": "image-processing-pipeline",
  "version": "1.1.0",
  "private": true,
  "description": "Serverless image processing pipeline on AWS: presigned S3 uploads, SQS-driven resizing with Sharp, DynamoDB status tracking. Built with CDK + TypeScript.",
  "engines": {
    "node": ">=22",
    "npm": ">=10.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "start": "http-server public -p 3000 -o"
  },
  "keywords": [
    "aws",
    "cdk",
    "serverless",
    "lambda",
    "s3",
    "sqs",
    "dynamodb",
    "sharp",
    "image-processing",
    "typescript"
  ],
  "author": "Oleh Bydlovskyi",
  "license": "MIT",
  "devDependencies": {
    "@smithy/util-stream": "^4.8.2",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1142.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "http-server": "^14.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-s3": "^3.490.0",
    "@aws-sdk/client-sqs": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@aws-sdk/s3-request-presigner": "^3.490.0",
    "aws-cdk-lib": "^2.270.0",
    "constructs": "^10.3.0",
    "sharp": "^0.35.4"
  }
}
